# Secretar-IA Environment Variables
# Copiá este archivo a .env y completá con tus valores reales
# NUNCA commitees el archivo .env real a GitHub

# Telegram Bot Token (obtenido de @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Groq API Key (obtenido de console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Tu User ID de Telegram (numérico, obtenido con @userinfobot)
MI_TELEGRAM_ID=your_telegram_user_id_here

# PostgreSQL Connection String (Neon.tech u otro proveedor)
# Formato: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Puerto para el health check en Render (Render inyecta PORT automáticamente)
PORT=10000

# Zona horaria para el bot
TIMEZONE=America/Argentina/Buenos_Aires

# Modelos de Groq (opcional, tienen defaults)
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3